    for letter_hw in hidden_word:
        if letter_hw == letter:
            display += letter
            correct_letters.append(letter)
        elif letter in correct_letters:
            display += letter
        else:
            display += "_"          # first time to set up blanks

    for a in correct_letters:
        hangman_word2.extend(a)
    letters_print()

