# zeeborg ski slope
# define custom functions
def turn_right():
    turn_left()
    turn_left()
    turn_left()

def zig():
    turn_left()
    move()

def zag():
    turn_right()
    move()

def double_move():
    move()
    move()

def s_curve_ski():
    move()
    zag()
    move()
    zig()
    move()
    zig()
    move()
    zag()

#route down slope
double_move()
zig()
zag()
# for loop for repeating pattern
for i in range(4):
    s_curve_ski()
move()
zag()
move()
