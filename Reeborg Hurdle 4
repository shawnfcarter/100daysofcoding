#hurdle 4
#double while loops in action

def turn_right():
    turn_left()
    turn_left()
    turn_left()

def over_the_top():
    turn_right()
    move()
    turn_right()
    
def jump():
    turn_left()
    while wall_on_right():
        move()
    over_the_top()    
    while front_is_clear():
        move()
    turn_left()
    
while not at_goal():
    if front_is_clear(): #check if front clear
        move()
    else:  #check if bordering the wall
        jump()
print("The end")  
    
    
